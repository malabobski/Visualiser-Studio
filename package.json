{
  "name": "audio-visualiser-studio",
  "version": "1.2.8",
  "private": true,
  "description": "Turn audio tracks into visualiser videos.",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --publish never",
    "test:midi": "node --test tests/midi.test.js",
    "test:volume": "node --test tests/media-volume.test.js",
    "dist:publish": "electron-builder --win --publish always",
    "test:updates": "node --test tests/updates.test.js",
    "dist:publish:bridge": "electron-builder --win --publish always --config build/bridge-release.cjs",
    "test:achievements": "node --test tests/achievements.test.js",
    "dist:mac": "node build/mac-build.cjs",
    "test:mac": "node --test tests/mac-port.test.js",
    "dist:mac:preview": "node build/mac-build.cjs --preview"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "fft.js": "^4.0.4"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.malchim.audiovisualiser",
    "productName": "Visualiser Studio",
    "files": [
      "**/*",
      "!*.bat",
      "!README.md",
      "!.git/**",
      "!dist/**",
      "!tests/**",
      "!UPDATES.md",
      "!RELEASE_NOTES_*.md",
      "!build/create-installer-art.cjs",
      "!build/installer.nsh",
      "!build/installer*.bmp",
      "!build/bridge-release.cjs",
      "!MAC_PORT.md",
      "!build/mac-build.cjs",
      "!MAC_TESTING.md",
      "!build/mac-preview.cjs",
      "!build/verify-mac.cjs",
      "!.github/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "now-playing.ps1",
      "media-volume.ps1",
      "mac-media.jxa",
      "mac-music-art.applescript"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Visualiser-Studio-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "minimumSystemVersion": "14.2",
      "artifactName": "Visualiser-Studio-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Visualiser Studio uses system audio to animate live music visualisers.",
        "NSAppleEventsUsageDescription": "Visualiser Studio reads track details and controls playback and volume in Spotify and Apple Music."
      },
      "entitlements": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "malabobski",
        "repo": "Visualiser-Studio-Releases",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "en_US"
      ],
      "runAfterFinish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/malabobski/Visualiser-Studio.git"
  }
}
