{
  "name": "audio-visualiser-studio",
  "version": "1.2.0",
  "private": true,
  "description": "Turn audio tracks into visualiser videos.",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "discord-rpc": "^4.0.1",
    "ffmpeg-static": "^5.2.0",
    "fft.js": "^4.0.4"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.malchim.audiovisualiser",
    "productName": "Visualiser Studio",
    "files": [
      "**/*",
      "!*.bat",
      "!README.md",
      "!.git/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "now-playing.ps1"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
